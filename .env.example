# ====================================================================
# VARIABLES DE ENTORNO: App de Coordinación de Presencia
# Guarda una copia como .env.local para desarrollo local (nunca subir al repo)
# ====================================================================

# 1. Supabase (Base de datos, Autenticación y Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... # ¡SECRETA! Solo en servidor

# 2. Bot de Telegram (Canal de notificación principal gratuito)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_WEBHOOK_SECRET=un_secreto_aleatorio_muy_largo_y_seguro_telegram_12345
TELEGRAM_ADMIN_CHAT_ID=987654321

# 3. Resend (Respaldo por correo electrónico)
# Opcional si solo se usa el correo integrado de Supabase para magic links
RESEND_API_KEY=re_123456789_abcdef
EMAIL_FROM=notificaciones@tudominio.com

# 4. Configuración del Administrador
ADMIN_EMAIL=alfonso@ejemplo.com

# 5. Seguridad de Tareas Programadas (Cron)
CRON_SECRET=clave_secreta_super_segura_para_proteger_endpoints_de_cron_67890

# 6. URL Base y Zona Horaria
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TIMEZONE=America/Mexico_City
